# Logs
logs/*.log

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Session state (local, gitignored)
.session-identity
.session-stats
.push-logs.lock

# Hook tool pinning (per-installation, generated by tools-init.sh)
scripts/hooks/lib/tools.lock

# Local instance data (not shared)
local/*
!local/.gitkeep
!local/README.md

# Knowledge research compile cache
knowledge/research/.last_compile

# Secrets (directory tracked, contents ignored)
secrets/*
!secrets/.gitkeep
!secrets/.secretpaths

# Engine adapter files (generated by init-project.sh --engine)
CLAUDE.md
.claude/settings.local.json
.claude/commands/
.claude/skills/
.claude/worktrees/

# .claude/settings.json is deliberately TRACKED, not generated-and-ignored.
# It holds the hook wiring, and hooks are what let a fresh clone set itself up.
# When it was ignored, a clone had no hooks, so nothing could run on session
# start — including the check that tells you the clone is not bootstrapped.
# generate-engine.sh therefore creates it only when missing (use --force to
# regenerate from the template). CODEX.md is tracked for the same reason —
# Codex has no hooks at all, so a fresh clone must ship its instructions
# (including how to bootstrap). Machine-specific overrides belong in
# .claude/settings.local.json, which stays ignored.
