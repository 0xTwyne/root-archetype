# Logs
logs/*.log

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Session state (local, gitignored)
.session-identity
.session-stats
.push-logs.lock

# Hook tool pinning (per-installation, generated by tools-init.sh)
scripts/hooks/lib/tools.lock

# Local instance data (not shared)
local/*
!local/.gitkeep
!local/README.md

# Knowledge research compile cache
knowledge/research/.last_compile

# Secrets (directory tracked, contents ignored)
secrets/*
!secrets/.gitkeep
!secrets/.secretpaths

# Engine adapter files (generated by init-project.sh --engine)
CLAUDE.md
CODEX.md
.claude/settings.json
.claude/settings.local.json
.claude/commands/
.claude/skills/
.claude/worktrees/

# --- Archetype development logs stay LOCAL ---
# This repo is the template, not a workspace. Progress reports, audit trails and
# notes produced by working ON the archetype are the developer's history, not
# template content — and this repo is public. Only the skeleton is tracked.
# (Same rules as 0xTwyne/root-archetype PR #34; applied here so they hold now.)
logs/progress/*
!logs/progress/.gitkeep
logs/audit/*
!logs/audit/.gitkeep
logs/skills/*
!logs/skills/.gitkeep
notes/*/
!notes/handoffs/
notes/handoffs/*
!notes/handoffs/.gitkeep
!notes/handoffs/INDEX.md
logs/.current_session
